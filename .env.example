# --- squamata-whatsapp ---
# Porta do servico HTTP (padrao do ecossistema: 3006; 3005 e o squamata-upload)
SQUAMATA_WHATSAPP_PORT=3006

# Caminho do arquivo SQLite que guarda o estado das sessoes (store do whatsmeow).
# Dev (nativo no host, Windows ou Linux): ./data/whatsapp.db
# Producao (container): /data/whatsapp.db (volume persistente, ver ADR 005)
SQUAMATA_WHATSAPP_DB_PATH=./data/whatsapp.db

# Token de servico-para-servico. Obrigatorio: o servico NAO sobe sem ele.
# Nao e o JWT do Squamata-Login: este servico nao tem usuario logado.
SQUAMATA_INTERNAL_TOKEN=troque-este-valor

# Webhook que recebe os eventos de sessao (status, QR, falha de autenticacao).
# Vazio = dispatcher desligado (dev sem o Calango-bot no ar).
SQUAMATA_WEBHOOK_URL=

# Segredo do HMAC-SHA256 enviado no header X-Signature.
# Obrigatorio quando SQUAMATA_WEBHOOK_URL estiver definido.
SQUAMATA_WEBHOOK_SECRET=
